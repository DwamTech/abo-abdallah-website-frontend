# Public API origin used by server and browser reads.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only token shared with the Laravel fatwa BFF middleware.
# Generate a strong independent value, set the same value on both services,
# and never expose it with a NEXT_PUBLIC_ prefix.
# The reverse proxy in front of Next.js must overwrite Host, X-Forwarded-Host,
# X-Forwarded-Proto, and X-Real-IP. These headers are required by the
# same-origin mutation guard and the per-client fatwa rate limiter. The
# application port must not be exposed directly to the public internet.
FATWA_BFF_SHARED_SECRET=

# Server-only HMAC key shared with Laravel for per-client library-index form
# throttling. Generate an independent random value and never use NEXT_PUBLIC_.
LIBRARY_INDEXES_BFF_SHARED_SECRET=

# Public comments are an optional frontend module because this source is shared
# by websites that may not install the comments backend module.
PUBLIC_COMMENTS_ENABLED=false

# Enables the read-only Subject Indexes area on the public website.
# This is evaluated on the server and must not use a NEXT_PUBLIC_ prefix.
PUBLIC_LIBRARY_SUBJECT_INDEXES_ENABLED=false

# Server-only key used to sign the proxy-resolved visitor IP on comment writes.
# Set the same independent random value in Laravel; never use NEXT_PUBLIC_ here.
# The public reverse proxy must overwrite X-Real-IP before forwarding to Next.
COMMENTS_BFF_SHARED_SECRET=
